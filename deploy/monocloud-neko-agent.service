[Unit]
Description=MonoCloud Neko agent
After=network-online.target
After=monocloud-neko-bridge.service
Wants=monocloud-neko-bridge.service

[Service]
Type=simple
EnvironmentFile=%h/.config/monocloud-neko-bridge/agent.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B %h/.local/lib/monocloud-neko-bridge/run_agent.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=60
LogRateLimitBurst=20

[Install]
WantedBy=default.target
