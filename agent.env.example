# Linux only: copy to its private config directory; chmod 600.
# macOS installer generates this file; do not pre-create it.
# Example values only. Use a separate Agent backend and tokens for each machine.
NEKO_SERVER=https://neko.example.invalid
NEKO_BACKEND_ID=1
NEKO_BACKEND_TOKEN=replace-with-agent-backend-token
NEKO_GATEWAY_TYPE=clash
# Linux: 19092; macOS installer generates its own config using 19093.
NEKO_GATEWAY_URL=http://127.0.0.1:19092
NEKO_GATEWAY_TOKEN=replace-with-independent-random-gateway-token
# Optional macOS IPC override, normally unnecessary:
# MONOPROXY_LOCAL_PASSWORD=replace-with-client-compatible-local-handshake-value
